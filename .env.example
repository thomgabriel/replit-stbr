# Copie este arquivo para `.env` e preencha os valores.
# O `.env` é gitignored — nunca commite credenciais.

# Connection string do Neon (obrigatório)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Domínio(s) de produção (obrigatório em prod). Aceita lista separada por vírgula.
# Em dev, localhost:3000/5173/127.0.0.1:3000 são permitidos automaticamente.
# Ex: https://replit-stbr.vercel.app
# Ex múltiplos: https://replit-stbr.vercel.app,https://replit.superteambr.com
SITE_ORIGIN=https://your-domain.com

# Salt aleatório pro hash de IP no rate-limit. Gere com:
#   openssl rand -hex 32
# Sem isto, um salt default (público no código) é usado — OK pra dev, ruim pra prod.
RATE_SALT=replace-me-with-a-long-random-string
